namespace Tecnica.Infra.Auth
{
    public class CustomAuthorizationAttribute : Attribute
    {
        public string Perfil { get; set; }
        public string ModuleId { get; set; }

        public CustomAuthorizationAttribute(string perfil, string moduleId)
        {
            Perfil = perfil;
            ModuleId = moduleId;
        }

        public const string ALLOWEDMODULE = "ALLOW";

    }

    public class TipoPerfilAuth
    {
        public const string ADMIN = "ADMIN";

        public const string CLIENTE = "CLIENTE";
    }
}
